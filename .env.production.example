# =========================================================
# Production Environment Variables for Oracle Cloud VPS
# =========================================================

# 1. Your Custom Domain (e.g. inventory.yourcompany.com or yourcompany.com)
DOMAIN_NAME=inventory.yourcompany.com
DJANGO_ALLOWED_HOSTS=inventory.yourcompany.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://inventory.yourcompany.com

# 2. Django Security Key (Generate a random 50+ character string)
DJANGO_SECRET_KEY=generate-a-unique-random-secret-key-at-least-50-chars-long
DJANGO_DEBUG=false

# 3. Database configuration (Uses persistent Docker volume)
DB_ENGINE=sqlite
DB_PATH=/srv/app/data/db.sqlite3

# 4. Proxy & Cache Settings
TRUSTED_PROXY_COUNT=1
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_CACHE_BACKEND=locmem
TIME_ZONE=Asia/Colombo

# 5. First-run Super Admin (Automatically created on first launch)
# Once you sign in successfully, you can delete SEED_ADMIN_PASSWORD
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=YourSecureAdminPassword123!
SEED_COMPANY_NAME=Your Company Name

# 6. Container runtime
RUN_MIGRATIONS=true
WEB_CONCURRENCY=2
PORT=8000
